# Copy to .env and fill in. Never commit .env.

# --- Pixxi ---
# Mock (default): run `uvicorn mock_pixxi.app:app --port 8001`; any non-empty token works.
PIXXI_MODE=mock
PIXXI_BASE_URL=http://127.0.0.1:8001
PIXXI_TOKEN=mock-token
# Real API: Pixxi CRM > Admin > Integrations > Pixxi Forms to get the token.
# PIXXI_MODE=real
# PIXXI_BASE_URL=https://dataapi.pixxicrm.ae
# PIXXI_TOKEN=<your X-PIXXI-TOKEN>
PIXXI_APP_NAME=PixxiAgents
PIXXI_MIN_READ_INTERVAL=2.0
PIXXI_PAGE_SIZE=100

# --- Webhook receiver ---
# Pixxi calls this from its servers, so for the real API it must be publicly reachable.
WEBHOOK_PUBLIC_BASE_URL=http://127.0.0.1:8002
WEBHOOK_SECRET=change-me
SELF_WRITE_WINDOW_SECONDS=120

# --- LLM ---
# Provider is switchable: openai (default) or anthropic. Only the selected provider's key is needed.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
# Refuse further LLM calls after this many in one process (protects a small API budget).
LLM_MAX_CALLS_PER_PROCESS=50
# USD per 1M tokens, only for the cost estimate in eval/runs/llm_calls.jsonl.
LLM_PRICE_INPUT_PER_MTOK=0.40
LLM_PRICE_OUTPUT_PER_MTOK=1.60
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

DORMANCY_DAYS=30
